{
  "name": "CareerFlow — scheduled reminders & follow-ups",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "minutes", "minutesInterval": 15 }] }
      },
      "id": "schedule-trigger",
      "name": "Every 15 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [260, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CAREERFLOW_APP_URL }}/api/internal/run-notifications",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-internal-secret", "value": "={{ $env.INTERNAL_API_SECRET }}" }
          ]
        }
      },
      "id": "post-run-notifications",
      "name": "POST /api/internal/run-notifications",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [560, 300]
    }
  ],
  "connections": {
    "Every 15 minutes": {
      "main": [[{ "node": "POST /api/internal/run-notifications", "type": "main", "index": 0 }]]
    }
  },
  "settings": {},
  "notes": "Generates due interview reminders (24h + 1h) and nudge notifications for all users. No Gmail needed."
}
