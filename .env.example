# CareerFlow environment — copy to `.env` for local dev, or set these in the Vercel dashboard.

# --- Database (required) ---
# Local: the docker-compose Postgres. Production: a free Neon database (neon.tech),
# which Vercel can provision for you via the Storage tab.
DATABASE_URL="postgresql://careerflow:careerflow@localhost:5433/careerflow?schema=public"

# --- Auth (required) ---
# Generate a strong secret with:  openssl rand -base64 32
AUTH_SECRET="dev-secret-change-me"
AUTH_TRUST_HOST=true

# Shared secret for internal API calls (e.g. the n8n AI layer).
INTERNAL_API_SECRET="dev-internal-secret"

# --- CV file storage (optional) ---
# Leave unset for local dev (files go to ./uploads). On Vercel, enable Blob storage in the
# Storage tab and this token is injected automatically — CV uploads then use the free Blob tier.
# BLOB_READ_WRITE_TOKEN=

# --- DevMaster Hub integration (optional) ---
# The interview-prep app's URL. Defaults to http://localhost:4200 when unset.
# After deploying DevMaster, set this to its Vercel URL.
# NEXT_PUBLIC_DEVMASTER_URL=https://your-devmaster.vercel.app

# --- Managed AI (optional) ---
# MANAGED_AI_PROVIDER=
# MANAGED_AI_MODEL=
# MANAGED_AI_KEY=
